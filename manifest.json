{
  "manifest_version": 3,
  "name": "Trello Copy List as Text",
  "version": "1.0.0",
  "description": "Adds a copy button to each Trello list header. Click to copy all cards as ## title + description, one blank line between cards.",
  "permissions": ["clipboardWrite"],
  "host_permissions": ["https://trello.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://trello.com/*", "https://*.trello.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
